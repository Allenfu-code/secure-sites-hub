# Store the real file outside the repository with mode 0600.
SITES_HUB_DATA_DIR=/var/lib/secure-sites-hub
SITES_HUB_REGISTRY=/etc/secure-sites-hub/sites.yaml
SITES_HUB_AUTH_DB=/etc/secure-sites-hub/accounts.sqlite3
SITES_HUB_AUTH_DB_IMMUTABLE=false
SITES_HUB_SESSION_SECRET_FILE=/var/lib/secure-sites-hub/session-secret
SITES_HUB_AUTH_CACHE_FILE=/var/lib/secure-sites-hub/account-cache.json
SITES_HUB_UPSTREAM=http://127.0.0.1:9620
SITES_HUB_PUBLIC_HOST=sites.example.com

SITES_HUB_DISCOVERY_ENABLED=false
SITES_HUB_PROBES_ENABLED=false
SITES_HUB_EXPOSE_INTERNALS=false
SITES_HUB_ALLOW_PRIVATE_HTTP=false
SITES_HUB_DISCOVERY_ROOTS=/srv/projects:/opt/services

# Set EXPOSE_INTERNALS and PROBES_ENABLED to true only for a loopback origin
# that is fully protected by the authentication gateway. Discovery also needs
# DISCOVERY_ENABLED=true and explicit roots.

LOCAL_CHECK_INTERVAL=60
PUBLIC_CHECK_INTERVAL=300
DISCOVERY_INTERVAL=900

# Optional second factor at the origin. Configure both values before enabling.
CLOUDFLARE_ACCESS_REQUIRED=false
CF_ACCESS_TEAM_DOMAIN=REPLACE_WITH_TEAM.cloudflareaccess.com
CF_ACCESS_AUD=REPLACE_WITH_APPLICATION_AUDIENCE
