[Unit]
Description=Secure Sites Hub read-only origin
After=network.target

[Service]
Type=simple
User=sites-hub
Group=sites-hub
WorkingDirectory=/opt/secure-sites-hub
EnvironmentFile=/etc/secure-sites-hub/sites-hub.env
ExecStart=/opt/secure-sites-hub/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 9620 --no-proxy-headers
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
ReadWritePaths=/var/lib/secure-sites-hub
ReadOnlyPaths=/etc/secure-sites-hub

[Install]
WantedBy=multi-user.target
